# Throwaway e2e stack for chief/inventory/e2e/run.sh. Test-only placeholder values (as in upstream
# docker/testing/compose.yml); nothing here is a credential. Ports are the throwaway containers run.sh starts.
NEXTAUTH_SECRET=secret
NEXT_PRIVATE_ENCRYPTION_KEY=CAFEBABE
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=DEADBEEF
NEXT_PRIVATE_DATABASE_URL=postgresql://postgres:testonly@127.0.0.1:55499/documenso_test
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgresql://postgres:testonly@127.0.0.1:55499/documenso_test
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3399
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3399
PORT=3399
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
NEXT_PRIVATE_JOBS_PROVIDER=local
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=../../apps/remix/example/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE=
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=127.0.0.1
NEXT_PRIVATE_SMTP_PORT=55025
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=true
NEXT_PRIVATE_SMTP_FROM_NAME="Fleet e2e"
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@example.test
# Isolation (review r4 [14]): run.sh starts from `env -i` + an allowlist, and preflight.cjs refuses to run unless the
# database and mail settings below are the only ones. These are set EMPTY on purpose: any dotenv loader (Playwright's
# config, the Prisma CLI) never overrides a variable that already exists, so an empty value here also stops a repo
# .env from restoring a replica, a Nodemailer service or SMTP credentials.
NEXT_PRIVATE_DATABASE_REPLICA_URLS=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
NEXT_PRIVATE_SMTP_SERVICE=
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_APIKEY=
NEXT_PRIVATE_SMTP_APIKEY_USER=
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_RESEND_API_KEY=
NEXT_PRIVATE_MAILCHANNELS_API_KEY=
NEXT_PRIVATE_MAILCHANNELS_ENDPOINT=
# The replica-lag spec (review r5 [18]) receives the server's webhook on a loopback HTTP sink in the test process.
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=127.0.0.1
DOCUMENSO_DISABLE_TELEMETRY=true
DANGEROUS_BYPASS_RATE_LIMITS=true
CHIEF_E2E_MAILPIT_URL=http://127.0.0.1:55026
CHIEF_E2E_RECIPIENT_URL=http://localhost:3398
CHIEF_RECIPIENT_PORT=3398
